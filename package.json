{
  "name": "website",
  "description": "Made and Copper by Simtropolis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "node scripts/run-next.mjs build",
    "dev": "node scripts/run-next.mjs dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs && bun test components/releases.test.jsx components/copper-demo/demo.test.js",
    "test:demo:rust": "node scripts/demo-fixtures.mjs --rust"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@next/env": "15.5.25",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.42.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
